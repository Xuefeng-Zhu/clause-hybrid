# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# Firebase Web SDK configuration for client-side Firebase AI Logic hybrid inference
# (Gemini Nano on-device in Chrome + cloud Gemini fallback). When unset, Clause falls
# back to server-side quote/policy parsing.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase App Check (mandatory when AI Logic App Check enforcement is enabled)
# Production / staging reCAPTCHA Enterprise site key:
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Local dev / CI App Check debug token UUID (or "true" to auto-generate in console; never commit real tokens):
VITE_APPCHECK_DEBUG_TOKEN=

# Default cloud Gemini model for Firebase AI Logic fallback (Gemini 3.x+; defaults to gemini-3.5-flash-lite)
VITE_CLOUD_MODEL=
