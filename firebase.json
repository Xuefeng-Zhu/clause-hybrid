{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "deploy/hosting-public",
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "clause-hybrid-preview",
          "region": "us-west1"
        }
      }
    ]
  }
}
